{
  "name": "detektif-sql",
  "version": "0.1.0",
  "private": true,
  "description": "Detektif SQL — game detektif berbasis SQL, client-first, gratis penuh.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "content:build": "tsx scripts/build-content.ts",
    "content:verify": "tsx scripts/build-content.ts --check",
    "content:new": "tsx scripts/new-chapter.ts",
    "worker:build": "tsx scripts/build-worker.ts",
    "prebuild": "npm run content:build && npm run worker:build",
    "predev": "npm run content:build && npm run worker:build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "comlink": "^4.4.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "ulidx": "^2.4.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.24.0",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
